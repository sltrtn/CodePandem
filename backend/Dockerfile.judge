FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Create a non-root user for running untrusted code.
RUN useradd -m judge

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Ensure the temp directory is writable by the non-root user.
RUN chown -R judge:judge /tmp

USER judge

EXPOSE 9000

CMD ["uvicorn", "app.judge_worker:app", "--host", "0.0.0.0", "--port", "9000"]
